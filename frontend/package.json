{
  "name": "novel2epub-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "tauri": "tauri",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "install:all": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "dev:desktop": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build:desktop": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "build:desktop:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1 -Debug",
    "build:desktop:clean": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1 -Clean"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.1.1",
    "@fontsource-variable/literata": "^5.1.1",
    "@fontsource/be-vietnam-pro": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@tanstack/react-query": "^5.62.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.16",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "react-router": "^7.1.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  }
}
